{
  "openapi": "3.1.0",
  "info": {
    "title": "Conference registration API",
    "version": "1.0.0",
    "description": "Contract between the frontend or organizer and the backend. Specification: docs/02_specification.md sections 4, 8, 9."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/form-config": {
      "get": {
        "operationId": "getFormConfig",
        "summary": "Form configuration: active options, consents, reCAPTCHA site key (AC-003-01)",
        "responses": {
          "200": {
            "description": "Configuration",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FormConfig" } } }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/registrations": {
      "post": {
        "operationId": "createRegistration",
        "summary": "Submit a registration (US-001, US-002)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Accepted, stored in the database and as JSON copy",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationCreated" } } }
          },
          "400": {
            "description": "Rejected: field errors (validation or reCAPTCHA) or malformed JSON; nothing stored, nothing sent",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "Body larger than the configured limit",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": {
            "description": "Could not be stored (for example JSON copy not writable); nothing left in the database",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/export": {
      "get": {
        "operationId": "exportRegistrations",
        "summary": "Excel export for organizers (US-008)",
        "security": [{ "organizerBasic": [] }],
        "responses": {
          "200": {
            "description": "Workbook with one row per registration",
            "headers": {
              "Content-Disposition": {
                "schema": { "type": "string", "const": "attachment; filename=\"registrations.xlsx\"" }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": {
            "description": "Missing or wrong credentials; no registration data",
            "headers": { "WWW-Authenticate": { "schema": { "type": "string" } } }
          },
          "403": {
            "description": "Plain HTTP from a non-loopback client while HTTPS-only is on (SR-06, D-10)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "organizerBasic": { "type": "http", "scheme": "basic" }
    },
    "responses": {
      "TooManyRequests": {
        "description": "Rate limit per client exceeded",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "RegistrationType": { "type": "string", "enum": ["EXTERNAL", "STUDENT"] },
      "Category": { "type": "string", "enum": ["WORKSHOP", "EVENT", "MEAL", "OTHER"] },
      "FormConfig": {
        "type": "object",
        "required": ["conferenceName", "recaptcha", "options", "consents"],
        "additionalProperties": false,
        "properties": {
          "conferenceName": { "type": "string" },
          "recaptcha": {
            "type": "object",
            "required": ["siteKey", "testMode"],
            "additionalProperties": false,
            "properties": {
              "siteKey": { "type": "string" },
              "testMode": { "type": "boolean" }
            }
          },
          "options": { "type": "array", "items": { "$ref": "#/components/schemas/Option" } },
          "consents": { "type": "array", "items": { "$ref": "#/components/schemas/Consent" } }
        }
      },
      "Option": {
        "type": "object",
        "required": ["id", "name", "category", "availableTo"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "$ref": "#/components/schemas/Category" },
          "availableTo": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/RegistrationType" }
          }
        }
      },
      "Consent": {
        "type": "object",
        "required": ["id", "text", "mandatory"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "mandatory": { "type": "boolean" }
        }
      },
      "RegistrationRequest": {
        "type": "object",
        "description": "Text fields are trimmed. EXTERNAL requires organization; STUDENT requires studyInstitution, studyProgramme, studentId; fields of the other type must be absent or blank.",
        "properties": {
          "type": { "$ref": "#/components/schemas/RegistrationType" },
          "firstName": { "type": "string", "maxLength": 100 },
          "lastName": { "type": "string", "maxLength": 100 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "organization": { "type": "string", "maxLength": 200 },
          "studyInstitution": { "type": "string", "maxLength": 200 },
          "studyProgramme": { "type": "string", "maxLength": 200 },
          "studentId": { "type": "string", "maxLength": 50 },
          "optionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "consents": { "type": "array", "items": { "type": "string" }, "description": "Ids of the consents given" },
          "recaptchaToken": { "type": "string" }
        }
      },
      "RegistrationCreated": {
        "type": "object",
        "required": ["id", "type", "firstName", "lastName", "options", "registeredAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": { "$ref": "#/components/schemas/RegistrationType" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "category"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "category": { "$ref": "#/components/schemas/Category" }
              }
            }
          },
          "registeredAt": { "type": "string", "format": "date-time" }
        }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "field": {
            "type": "string",
            "description": "type, firstName, lastName, email, organization, studyInstitution, studyProgramme, studentId, optionIds, consents, consents.<id>, recaptchaToken"
          },
          "message": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "fieldErrors": { "type": "array", "items": { "$ref": "#/components/schemas/FieldError" } }
        }
      }
    }
  }
}
